{
  "name": "bitrate-analyser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-only FFprobe WebAssembly bitrate and GOP viewer",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8001 --directory dist",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.57.0"
  }
}
