{
  "name": "bitrate-analyser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-only FFprobe WebAssembly bitrate and GOP viewer",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8001 --directory dist",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.57.0",
    "prettier": "3.9.10"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "htmlWhitespaceSensitivity": "ignore"
        }
      }
    ]
  }
}
